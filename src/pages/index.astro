---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../utils/url";

const sections = [
  {
    href: withBase("/portfolio"),
    name: "portfolio/",
    perms: "drwxr-xr-x",
    size: "4.0K",
    description: "projects, write-ups and CTF tooling",
  },
  {
    href: withBase("/wiki"),
    name: "wiki/",
    perms: "drwxr-xr-x",
    size: "2.1K",
    description: "notes, cheatsheets and lab setup",
  },
  {
    href: withBase("/blog"),
    name: "blog/",
    perms: "drwxr-xr-x",
    size: "1.3K",
    description: "news, logs and post-mortems",
  },
];

const profile = [
  { key: "role", value: "security student" },
  { key: "focus", value: "offensive security" },
  { key: "stack", value: "linux · python · burp" },
  { key: "learning", value: "OSCP (in progress)" },
  { key: "location", value: "remote / EU" },
];
---

<Layout
  title="home"
  description="Cybersecurity student and ethical hacker. Write-ups, notes and projects."
>
  <section
    class="grid items-start gap-5 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.85fr)] lg:gap-6"
  >
    <div class="terminal">
      <div class="terminal-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="ml-1">visitor@atlas: ~</span>
        <span class="ml-auto tracking-[0.14em] uppercase">zsh</span>
      </div>

      <div class="terminal-body">
        <p>
          <span class="prompt">visitor@atlas</span><span class="pwd">:~$</span>{" "}
          <span class="cmd">whoami</span>
        </p>
        <p class="out">cybersecurity student · ethical hacker</p>

        <p class="mt-4">
          <span class="prompt">visitor@atlas</span><span class="pwd">:~$</span>{" "}
          <span class="cmd">cat about.txt</span>
        </p>
        <p class="out">I break things in labs, document the process, and rebuild them</p>
        <p class="out">stronger. Currently working through HTB and writing it all down.</p>

        <p class="mt-4">
          <span class="prompt">visitor@atlas</span><span class="pwd">:~$</span>{" "}
          <span class="cmd">ls ./links</span>
        </p>
        <p class="flex flex-wrap gap-x-5 gap-y-1">
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="out underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >github</a
          >
          <a
            href="https://www.linkedin.com"
            target="_blank"
            rel="noopener noreferrer"
            class="out underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >linkedin</a
          >
          <a
            href="https://app.hackthebox.com"
            target="_blank"
            rel="noopener noreferrer"
            class="out underline decoration-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
            >hackthebox</a
          >
        </p>

        <p class="mt-4">
          <span class="prompt">visitor@atlas</span><span class="pwd">:~$</span>{" "}
          <span class="caret" aria-hidden="true"></span>
        </p>
      </div>
    </div>

    <aside class="panel self-start">
      <div class="panel-head">
        <span>profile.json</span>
        <span>utf-8</span>
      </div>

      <dl>
        {
          profile.map((row) => (
            <div class="krow">
              <dt>{row.key}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
        <div class="krow">
          <dt>status</dt>
          <dd class="flex items-center gap-2">
            <span class="inline-block size-1.5 rounded-full bg-accent" aria-hidden="true"
            ></span>
            open to internships
          </dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="mt-12 sm:mt-16">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-mono text-[0.8125rem] text-ink">
        <span class="text-accent" aria-hidden="true">$</span> ls -la ./atlas
      </h2>
      <span class="font-mono text-[11px] text-dim">3 entries</span>
    </div>

    <div class="mt-3 border-t border-line-soft">
      {
        sections.map((section) => (
          <a href={section.href} class="dir-row group">
            <span class="font-mono text-[11px] text-dim">{section.perms}</span>
            <span class="name">{section.name}</span>
            <span class="hidden text-sm text-muted md:block">{section.description}</span>
            <span class="arrow justify-self-end" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>

    <p class="mt-5 font-mono text-[11px] text-dim">
      // placeholder content — swap the bio, links and project entries before
      publishing
    </p>
  </section>
</Layout>