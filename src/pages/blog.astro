---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../utils/url";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const iso = (date: Date) => date.toISOString().slice(0, 10);

// n8n emits no description, so derive a one-line excerpt from the body.
const excerpt = (body = "") => {
  const text = body
    .replace(/^#{1,6}\s+.*$/gm, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_`~>]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return text.length > 150 ? `${text.slice(0, 150).trimEnd()}…` : text;
};
---

<Layout
  title="blog"
  description="A running log of write-ups, lab notes and security news."
>
  <header class="max-w-3xl">
    <p class="font-mono text-[11px] text-dim">// 04 — blog</p>
    <h1
      class="mt-3 font-mono text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-tight tracking-tight text-ink"
    >
      log stream
    </h1>
    <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-muted">
      Short entries, newest first. Write-ups, lab notes and the occasional rant
      about tooling.
    </p>
  </header>

  <section class="mt-9 sm:mt-12" aria-label="Posts">
    <div
      class="flex items-baseline justify-between gap-4 border-b border-line-soft pb-2"
    >
      <h2 class="font-mono text-[0.8125rem] text-ink">
        <span class="text-accent" aria-hidden="true">$</span> tail -f ./log/updates.log
      </h2>
      <span class="font-mono text-[11px] text-dim">{posts.length} lines</span>
    </div>

    {
      posts.length === 0 && (
        <p class="py-6 font-mono text-xs text-dim">
          no entries yet — waiting on the first post
        </p>
      )
    }

    {
      posts.map((post) => (
        <a href={withBase(`/blog/${post.id}`)} class="log-row group">
          <div class="font-mono text-[11px] text-dim">
            <time datetime={iso(post.data.date)}>{iso(post.data.date)}</time>
          </div>

          <div>
            <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
              <span class="tag">{post.data.tags[0] ?? "note"}</span>
              <h3 class="log-title">{post.data.title}</h3>
            </div>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
              {post.data.description ?? excerpt(post.body)}
            </p>
          </div>
        </a>
      ))
    }

    <p class="mt-6 flex items-center gap-2 font-mono text-[11px] text-dim">
      <span aria-hidden="true">--</span> EOF
      <span class="caret" style="height:0.85em;width:0.35em" aria-hidden="true"></span>
    </p>
  </section>
</Layout>