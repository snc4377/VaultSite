---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { withBase } from "../../utils/url";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.date.toISOString().slice(0, 10);
---

<Layout
  title={post.data.title}
  description={post.data.description ?? `${post.data.title} — a post by snc4377.`}
>
  <article class="max-w-3xl">
    <nav class="font-mono text-[11px] text-dim" aria-label="Breadcrumb">
      <a
        href={withBase("/blog")}
        class="transition-colors hover:text-accent">~/blog</a
      ><span class="text-[#3a3a3a]">/</span>{post.id}
    </nav>

    <h1
      class="mt-3 font-mono text-[clamp(1.4rem,3.2vw,2rem)] font-semibold leading-snug tracking-tight text-ink"
    >
      {post.data.title}
    </h1>

    <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-dim">
      <time datetime={published}>{published}</time>
      <span class="text-[#3a3a3a]" aria-hidden="true">·</span>
      <span>{post.data.tags.map((tag) => `#${tag}`).join(" ")}</span>
    </p>

    <div class="prose-doc mt-8">
      <Content />
    </div>

    <div class="mt-12 border-t border-line-soft pt-4">
      <a
        href={withBase("/blog")}
        class="font-mono text-xs text-dim transition-colors hover:text-accent"
        >← cd ..</a
      >
    </div>
  </article>
</Layout>