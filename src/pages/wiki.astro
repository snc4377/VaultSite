---
import Layout from "../layouts/Layout.astro";
import WikiSidebar from "../components/WikiSidebar.astro";
import { getCollection } from "astro:content";
import { withBase } from "../utils/url";

const notes = (await getCollection("wiki")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const iso = (date: Date) => date.toISOString().slice(0, 10);

const excerpt = (body = "") => {
  const text = body
    .replace(/^#{1,6}\s+.*$/gm, "")
    .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_`~>]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return text.length > 150 ? `${text.slice(0, 150).trimEnd()}…` : text;
};
---

<Layout
  title="wiki"
  description="A personal wiki: shell setup, recon notes and privilege escalation cheatsheets."
>
  <div class="grid gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10">
    <aside class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start">
      <WikiSidebar />
    </aside>

    <div class="min-w-0">
      <header class="max-w-3xl">
        <p class="font-mono text-[11px] text-dim">// 03 — wiki</p>
        <h1
          class="mt-3 font-mono text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-tight tracking-tight text-ink"
        >
          knowledge base
        </h1>
        <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-muted">
          Notes written for the version of me that has forgotten how this worked.
          One idea per entry, newest first.
        </p>
      </header>

      <section class="mt-9 sm:mt-12" aria-label="Wiki notes">
        <div
          class="flex items-baseline justify-between gap-4 border-b border-line-soft pb-2"
        >
          <h2 class="font-mono text-[0.8125rem] text-ink">
            <span class="text-accent" aria-hidden="true">$</span> ls ./wiki
          </h2>
          <span class="font-mono text-[11px] text-dim">{notes.length} notes</span>
        </div>

        {
          notes.length === 0 && (
            <p class="py-6 font-mono text-xs text-dim">
              no notes yet — add a .md file to src/content/wiki
            </p>
          )
        }

        {
          notes.map((note) => (
            <a href={withBase(`/wiki/${note.id}`)} class="log-row group">
              <div class="font-mono text-[11px] text-dim">
                <time datetime={iso(note.data.date)}>{iso(note.data.date)}</time>
              </div>

              <div>
                <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
                  {note.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                  <h3 class="log-title">{note.data.title}</h3>
                </div>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
                  {note.data.description ?? excerpt(note.body)}
                </p>
              </div>
            </a>
          ))
        }
      </section>
    </div>
  </div>
</Layout>