---
import Layout from "../layouts/Layout.astro";
import WikiSidebar from "../components/WikiSidebar.astro";
import { getCollection } from "astro:content";

const notes = await getCollection("wiki");
---

<Layout
  title="wiki"
  description="A personal wiki: shell setup, recon notes and privilege escalation cheatsheets."
>
  <div class="grid gap-8 lg:grid-cols-[20rem_minmax(0,1fr)] lg:gap-10">
    <aside class="lg:sticky lg:top-[calc(var(--header-h)+1.5rem)] lg:self-start">
      <WikiSidebar />
    </aside>

    <div class="min-w-0">
      <header class="max-w-3xl">
        <p class="font-mono text-[11px] text-dim">// 03 — wiki</p>
        <h1
          class="mt-3 font-mono text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-tight tracking-tight text-ink"
        >
          knowledge base
        </h1>
        <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-muted">
          Notes written for the version of me that has forgotten how this worked.
          Browse the explorer to pick a thread.
        </p>
      </header>

      <section class="mt-9 sm:mt-12" aria-label="Wiki overview">
        <div class="panel">
          <div class="panel-head">
            <span>
              <span class="text-accent" aria-hidden="true">$</span>{" "}
              wiki --status
            </span>
            <span>{notes.length} notes</span>
          </div>
          <div class="p-4 font-mono text-xs leading-relaxed text-muted">
            <p>
              <span class="text-accent" aria-hidden="true">›</span> select a note
              from the explorer.
            </p>
            <p class="mt-2 text-dim">
              {notes.length} notes indexed · pick a branch to begin.
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>
