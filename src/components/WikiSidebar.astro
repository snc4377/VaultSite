---
import { getCollection } from "astro:content";
import { noteDate, sortNotes } from "../utils/note";
import { withBase } from "../utils/url";

interface Props {
  current?: string;
}

const { current } = Astro.props;

const notes = sortNotes(await getCollection("wiki"));

const latest = notes[0];
const latestDate = latest ? noteDate(latest) : null;
---

<div class="panel">
  <div class="panel-head">
    <span>[ notes ]</span>
    <span>{String(notes.length).padStart(2, "0")}</span>
  </div>

  <nav aria-label="Wiki notes" class="p-3">
    <ul class="space-y-1 font-mono text-xs">
      {
        notes.map((note, index) => {
          const active = current === note.id;
          return (
            <li>
              <a
                href={withBase(`/wiki/${note.id}`)}
                class:list={[
                  "flex gap-2 py-0.5 transition-colors",
                  active ? "text-accent" : "text-muted hover:text-ink",
                ]}
                aria-current={active ? "page" : undefined}
              >
                <span class="whitespace-pre text-[#3a3a3a]" aria-hidden="true">
                  {index === notes.length - 1 ? "└─" : "├─"}
                </span>
                <span class="truncate">{note.id}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</div>

<div class="panel mt-3">
  <div class="panel-head">
    <span>last edit</span>
  </div>
  <div class="px-3 py-2.5 font-mono text-[11px] leading-relaxed">
    <p class="truncate text-muted">{latest?.id ?? "—"}</p>
    <p class="text-dim">{latest ? latestDate ?? "undated" : "no notes yet"}</p>
  </div>
</div>
